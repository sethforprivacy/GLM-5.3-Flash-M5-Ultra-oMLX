+            weight[e] = weight[200]
+            bias[e] = bias[200]
+        moe.gate.weight, moe.gate.e_score_correction_bias = weight, bias
+    for trial in range(4):
+        x = (mx.random.normal((1, 1, 4096)) * (0.3 + trial)).astype(mx.bfloat16)
+        before = _stats()["router_select_fused"]
