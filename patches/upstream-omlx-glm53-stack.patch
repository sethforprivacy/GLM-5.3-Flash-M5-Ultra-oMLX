+            "swa_head_dim": 32,
+            "swa_v_head_dim": 24,
+            "swa_rope_theta": 1000.0,
+            "sliding_window_size": 32,
+            "add_full_attention_sink_bias": False,
+            "add_swa_attention_sink_bias": True,
+            "hybrid_layer_pattern": [0, 1],
