+    ref = mx.concatenate(
+        [
+            _stock_sorted(x[:half], wq, scales, biases, idx[:half], mode, 4, gs),
+            _stock_sorted(x[half:], wq, scales, biases, idx[half:], mode, 4, gs),
+        ]
