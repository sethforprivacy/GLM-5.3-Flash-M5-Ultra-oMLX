+    tied = [int(i) for i in ref_indices[0, 0].tolist() if i in (7, 70, 140, 200, 280)]
+    assert tied == sorted(tied) and len(tied) == 5
+    assert mx.array_equal(indices, ref_indices).item()
+    assert _mismatches(scores, ref_scores) == 0
