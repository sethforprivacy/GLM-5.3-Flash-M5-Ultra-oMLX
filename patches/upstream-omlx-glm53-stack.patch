+def test_row_cap_is_a_multiple_of_64():
+    assert indexer_nax.max_rows_per_call(1) % 64 == 0
+    assert indexer_nax.max_rows_per_call(1 << 30) == 64
+    assert indexer_nax.max_rows_per_call(16384) == (1 << 27) // 16384
