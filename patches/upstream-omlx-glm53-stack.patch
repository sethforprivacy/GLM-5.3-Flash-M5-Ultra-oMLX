+        assert _stats()["moe_shared_split"] == split + 1
+        monkeypatch.setattr(dk, "DISABLED", {"moe_shared_split"})
+        one_launch = moe(x)
+        monkeypatch.setattr(dk, "DISABLED", {"router_select_fused"})
+        two_step = moe(x)
+        monkeypatch.setattr(dk, "DISABLED", set())
