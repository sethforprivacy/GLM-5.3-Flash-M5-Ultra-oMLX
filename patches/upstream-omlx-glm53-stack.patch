+
+    here = Path(__file__).resolve().parent
+    code = (
+        "import sys; sys.path[:0] = [%r, %r]\n"
+        "import test_glm5_next_mtp_fused_verify as t\n"
+        "from omlx.patches.mlx_vlm_glm5_next_compat import decode_kernels as dk\n"
