+    constexpr int BKP = BK + 16 / sizeof(WT);
+    threadgroup WT Ws[(SCHED == 1 ? 2 : 1) * omlx_gqmm::kBN * BKP +
+                      PAD / sizeof(WT)];
+    uint4 desc;
+    int y_col;
+    if (!omlx_gqmm::tile_of<GX>(
+            tiles, tile_count[0], threadgroup_position_in_grid, params[0],
+            desc, y_col)) {{
