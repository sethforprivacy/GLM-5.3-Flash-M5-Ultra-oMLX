new file mode 100644
index 00000000..c9ffb445
--- /dev/null
+++ b/omlx/patches/p2_hc_fused.py
@@ -0,0 +1,133 @@
+"""GLM-5.3 HyperConnection pre-mix in two dispatches at decode/verify shapes (phase 2, mac-studio-m5-ultra; OMLX_P2_HC_FUSED=1).
+
+The GLM-5.3 decoder runs HyperConnection.__call__ (fp32 cast, RMS norm, fp32 (rows, 16384) x (16384, 24) mix -- per token for
+verify blocks --, the sinkhorn/collapse kernel) and then the layer's RMSNorm: 5-8 dispatches, 90 times per step.
+
+mlx-vlm already ships a one-dispatch kernel for this (`_hc_normalized_norm_kernel`: normalize, mix, sinkhorn, collapse, output
+RMSNorm), but it only admits a bf16/fp16 mix weight, and GLM-5.3 stores it in fp32. It is also one threadgroup per row, so the
+1.5 MB fp32 weight read is serial. Here:
+
+1. `mix` kernel: one threadgroup per (output, row), 24 per row. Each computes the row's RMS factor with the one-dispatch kernel's
+   reduction tree and one mix output with its dot-product tree, so the mixes are bit-identical to that kernel's.
+2. mlx-vlm's `exact_hc_norm` (sinkhorn, collapse, output RMSNorm from the mixes).
+
+Result: bit-exact against the served path at one row, and every verify row computed the way a one-row decode computes it.
+25 us per call against 55 us in a dependent chain on M5 Ultra.
+"""
+import os
+
+import mlx.core as mx
+
+ENABLED = os.environ.get("OMLX_P2_HC_FUSED", "0") == "1"
+MAX_ROWS = int(os.environ.get("OMLX_P2_HC_FUSED_MAX_ROWS", "8"))
+
+_MIX_SOURCE = """
+uint out_idx = threadgroup_position_in_grid.x;
+uint row = threadgroup_position_in_grid.y;
+uint tid = thread_position_in_threadgroup.x;
+uint lane = thread_index_in_simdgroup;
+uint sg = simdgroup_index_in_threadgroup;
+constexpr int MIX = (2 + HC) * HC;
+constexpr int K_SIZE = HC * D;
+constexpr int TN = 4;
+constexpr int MIX_SIMDS = 8;
+constexpr int MIX_BLOCK = MIX_SIMDS * 32 * TN;
+constexpr float NORM_EPS = NORM_EPS_INT * 1e-9;
+const device T* x_row = x_in + row * K_SIZE;
+
+// RMS factor: same 1024-thread tree as mlx-vlm's short_block_hc_normalized_norm.
+threadgroup float norm_partials[32];
+threadgroup float inv_norm[1];
+float norm_sum = 0.0f;
+for (int k = int(tid) * TN; k < K_SIZE; k += 32 * 32 * TN) {
+  float4 value = float4(*(const device vec<T, 4>*)(x_row + k));
+  norm_sum += value.x * value.x;
+  norm_sum += value.y * value.y;
+  norm_sum += value.z * value.z;
+  norm_sum += value.w * value.w;
+}
+norm_sum = simd_sum(norm_sum);
+if (lane == 0) {
+  norm_partials[sg] = norm_sum;
+}
+threadgroup_barrier(mem_flags::mem_threadgroup);
+if (sg == 0) {
+  norm_sum = simd_sum(norm_partials[lane]);
+  if (lane == 0) {
+    inv_norm[0] = metal::precise::rsqrt(norm_sum / K_SIZE + NORM_EPS);
+  }
+}
+threadgroup_barrier(mem_flags::mem_threadgroup);
+
+// One mix output: same eight-SIMD dot-product tree as that kernel.
+threadgroup float mix_partials[MIX_SIMDS];
+if (sg < MIX_SIMDS) {
+  int bn = (int(sg) * 32 + int(lane)) * TN;
+  float result = 0.0f;
+  const device W* w_row = mix_weight + int(out_idx) * K_SIZE;
+  for (int k = 0; k < K_SIZE; k += MIX_BLOCK) {
+    float inv = inv_norm[0];
+    const device T* source_x = x_row + k + bn;
+    const device W* source_w = w_row + k + bn;
+    for (int tn = 0; tn < TN; ++tn) {
+      result += source_w[tn] * (float(source_x[tn]) * inv);
+    }
+  }
+  for (ushort offset = 16; offset >= 1; offset >>= 1) {
+    result += simd_shuffle_down(result, offset);
+  }
+  if (lane == 0) {
+    mix_partials[sg] = result;
+  }
+}
+threadgroup_barrier(mem_flags::mem_threadgroup);
+if (sg == 0 && lane == 0) {
+  float value = mix_partials[0];
+  for (int group = 1; group < MIX_SIMDS; ++group) {
+    value += mix_partials[group];
+  }
+  mixes[row * MIX + out_idx] = value;
+}
+"""
+_kernel = None
+
+
+def _mix_kernel():
+    global _kernel
+    if _kernel is None:
+        _kernel = mx.fast.metal_kernel(
+            name="p2_glm_hc_mix", input_names=["x_in", "mix_weight"], output_names=["mixes"], source=_MIX_SOURCE
+        )
+    return _kernel
+
+
+def eligible(hc, norm, x) -> bool:
+    return (
+        ENABLED
+        and not hc.training
+        and x.ndim == 4
+        and x.shape[0] * x.shape[1] <= MAX_ROWS
+        and x.shape[2:] == (4, 4096)
+        and x.dtype in (mx.bfloat16, mx.float16)
+        and hc.fn.shape == (24, 4 * 4096)
+        and norm.weight.dtype == x.dtype
+        and mx.default_device() == mx.gpu
+        and mx.metal.is_available()
+    )
+
+
+def hc_pre(hc, norm, x):
+    """(normed, post, comb) for HyperConnection `hc` followed by RMSNorm `norm`, or None if the shape is not handled."""
+    from mlx_vlm.models.fast_ops import exact_hc_norm
+
+    B, L = x.shape[:2]
+    x = mx.contiguous(x)
+    mixes = _mix_kernel()(
+        inputs=[x, hc.fn],
+        template=[("T", x.dtype), ("W", hc.fn.dtype), ("HC", 4), ("D", 4096), ("NORM_EPS_INT", round(hc.norm_eps / 1e-9))],
+        grid=(24 * 1024, B * L, 1),
+        threadgroup=(1024, 1, 1),
+        output_shapes=[(B, L, 24)],
+        output_dtypes=[mx.float32],
+    )[0]
+    return exact_hc_norm(hc, norm, x, mixes)
