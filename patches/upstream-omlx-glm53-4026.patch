+        template=[("T", q.dtype), ("D", D), ("H", H), ("LQ", L), ("HCH", heads_per_tg),
+                  ("FINFO_MIN_BITS", fmin)],
+        grid=(128 * (-(-W // 16)), H // heads_per_tg, L),
+        threadgroup=(128, 1, 1),
+        output_shapes=[(L * H, W)],
+        output_dtypes=[q.dtype],
+    )[0]
