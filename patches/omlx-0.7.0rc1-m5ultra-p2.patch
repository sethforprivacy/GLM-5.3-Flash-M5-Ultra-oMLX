index 0000000..fe3f156
--- /dev/null
+++ b/patches/p2_kda_fused.py
@@ -0,0 +1,162 @@
+"""Phase-2 (mac-studio-m5-ultra): GLM-5.3 KDA decode/verify as one Metal dispatch (B=1, S<=8).
+
+Replaces, per KDA layer: concat(q,k,v) → conv1d → silu → split → l2norm(q)·scale, l2norm(k) → compute_g_safe → sigmoid(b) →
+gated-delta recurrence, plus the conv-state update. That's ~17 dispatches down to 1. It reads q/k/v/b straight out of the fused
+in-projection output (no copies) and keeps the stock path's bf16 rounding points: conv out, sigmoid, silu, normed q/k, beta.
+
+Idea after mlx-serve #517 ("GDN prework + recurrence as one dispatch", MIT); this kernel is written for KDA's vector gate.
+Enabled by OMLX_GLM_KDA_FUSED=1 (only on the compiled-KDA path, OMLX_GLM_COMPILE_KDA=1).
+"""
+from __future__ import annotations
+
+import os
+
+import mlx.core as mx
+
+ENABLED = os.environ.get("OMLX_GLM_KDA_FUSED", "0") == "1"
+
+# Same functor bodies as MLX's Metal unary ops (unary_ops.h), so rounding matches the stock graph op for op.
+_HEADER = r"""
+template <typename T> inline T p2_sigmoid(T x) {
+    auto y = 1 / (1 + metal::exp(metal::abs(x)));
+    return (x < 0) ? y : 1 - y;
+}
+"""
+
+_SRC = r"""
+    constexpr int NPT = D / 32;
+    const uint h = thread_position_in_grid.z;
+    const uint dv = thread_position_in_grid.y;
+    const uint lane = thread_index_in_simdgroup;
+    const int S = T;
+    const float scale = metal::rsqrt(float(D));
+    const float lb = lower_bound[0];
+
+#define CI(r, c) ((r) < KS - 1 ? float(conv_state[(r) * C + (c)]) : float(fused[((r) - (KS - 1)) * CTOT + (c)]))
+
+    float wq[NPT][KS], wk[NPT][KS], wv[KS], dtb[NPT], st[NPT];
+    int cq[NPT], ck[NPT];
+    const int cv = 2 * QKV + h * D + dv;
+    for (int i = 0; i < NPT; ++i) {
+        int dk = lane * NPT + i;
+        cq[i] = h * D + dk;
+        ck[i] = QKV + h * D + dk;
+        for (int t = 0; t < KS; ++t) {
+            wq[i][t] = float(convw[cq[i] * KS + t]);
+            wk[i][t] = float(convw[ck[i] * KS + t]);
+        }
+        dtb[i] = float(dt_bias[h * D + dk]);
+    }
+    for (int t = 0; t < KS; ++t) wv[t] = float(convw[cv * KS + t]);
+    const float Aexp = metal::precise::exp(float(A_log[h]));
+
+    const size_t sbase = ((size_t)h * D + dv) * D;
+    for (int i = 0; i < NPT; ++i) st[i] = float(state_in[sbase + lane * NPT + i]);
+
+    for (int s = 0; s < S; ++s) {
+        float qf[NPT], kf[NPT];
+        float qss = 0.0f, kss = 0.0f;
+        for (int i = 0; i < NPT; ++i) {
+            float aq = 0.0f, ak = 0.0f;
+            for (int t = 0; t < KS; ++t) {
+                aq += wq[i][t] * CI(s + t, cq[i]);
+                ak += wk[i][t] * CI(s + t, ck[i]);
+            }
+            InT c1 = static_cast<InT>(aq);
+            InT c2 = static_cast<InT>(ak);
+            InT s1 = p2_sigmoid(c1);
+            InT s2 = p2_sigmoid(c2);
+            qf[i] = float(static_cast<InT>(c1 * s1));
+            kf[i] = float(static_cast<InT>(c2 * s2));
+            qss += qf[i] * qf[i];
+            kss += kf[i] * kf[i];
+        }
+        qss = simd_sum(qss);
+        kss = simd_sum(kss);
+        const float qi = metal::precise::rsqrt(qss + 1e-6f), ki = metal::precise::rsqrt(kss + 1e-6f);
+        float qn[NPT], kn[NPT], g[NPT];
+        for (int i = 0; i < NPT; ++i) {
+            qn[i] = float(static_cast<InT>((qf[i] * qi) * scale));
+            kn[i] = float(static_cast<InT>(kf[i] * ki));
+            float ai = float(a[(size_t)s * QKV + h * D + lane * NPT + i]) + dtb[i];
+            g[i] = metal::precise::exp(lb * p2_sigmoid(Aexp * ai));
+        }
+        float av = 0.0f;
+        for (int t = 0; t < KS; ++t) av += wv[t] * CI(s + t, cv);
+        InT c3 = static_cast<InT>(av);
+        InT s3 = p2_sigmoid(c3);
+        const float vf = float(static_cast<InT>(c3 * s3));
+        const float beta = float(p2_sigmoid(fused[(size_t)s * CTOT + BOFF + h]));
+
+        float kv = 0.0f;
+        for (int i = 0; i < NPT; ++i) {
+            st[i] = st[i] * g[i];
+            kv += st[i] * kn[i];
+        }
+        kv = simd_sum(kv);
+        const float delta = (vf - kv) * beta;
+        float o = 0.0f;
+        for (int i = 0; i < NPT; ++i) {
+            st[i] = st[i] + kn[i] * delta;
+            o += st[i] * qn[i];
+        }
+        o = simd_sum(o);
+        const size_t ybase = ((size_t)s * H + h) * D;
+        if (lane == 0) {
+            y[ybase + dv] = static_cast<InT>(o);
+            v_out[ybase + dv] = static_cast<InT>(vf);
+        }
+        if (dv == 0) {
+            for (int i = 0; i < NPT; ++i) {
+                q_out[ybase + lane * NPT + i] = static_cast<InT>(qn[i]);
+                k_out[ybase + lane * NPT + i] = static_cast<InT>(kn[i]);
+            }
+        }
+    }
+    for (int i = 0; i < NPT; ++i) state_out[sbase + lane * NPT + i] = st[i];
+    if (lane == 0) {
+        // new conv state = the last KS-1 rows of concat(conv_state, mixed), for this thread's q, k and v channel.
+        const int chans[3] = {(int)(h * D + dv), (int)(QKV + h * D + dv), cv};
+        for (int j = 0; j < 3; ++j)
+            for (int r = 0; r < KS - 1; ++r)
+                conv_out[r * C + chans[j]] = static_cast<InT>(CI(S + r, chans[j]));
+    }
+#undef CI
+"""
+
+_kernel = None
+
+
+def _get_kernel():
+    global _kernel
+    if _kernel is None:
+        _kernel = mx.fast.metal_kernel(
+            name="p2_glm_kda_fused",
+            input_names=["fused", "conv_state", "convw", "a", "A_log", "dt_bias", "state_in", "lower_bound", "T"],
+            output_names=["y", "state_out", "conv_out", "q_out", "k_out", "v_out"],
+            source=_SRC,
+            header=_HEADER,
+        )
+    return _kernel
+
+
+def kda_fused(fused, conv_state, convw, a, A_log, dt_bias, state, lower_bound, num_heads, head_dim):
+    """fused: (1,S,CTOT) in-proj output [q|k|v|f_a|g_a|b]; conv_state (1,KS-1,3*QKV); convw (3*QKV,KS,1); a (1,S,QKV);
+    A_log (H,) f32; dt_bias (QKV,) f32; state (1,H,D,D) f32. Returns y (1,S,H,D), new state, new conv state, q, k, v (1,S,H,D)."""
+    S, CTOT = fused.shape[1], fused.shape[2]
+    H, D = num_heads, head_dim
+    QKV = H * D
+    C = 3 * QKV
+    KS = convw.shape[1]
+    dt = fused.dtype
+    shp = (1, S, H, D)
+    outs = _get_kernel()(
+        inputs=[fused, conv_state, convw, a, A_log.reshape(-1), dt_bias.reshape(-1), state,
+                mx.array([float(lower_bound)], dtype=mx.float32), S],
+        template=[("InT", dt), ("D", D), ("H", H), ("QKV", QKV), ("C", C), ("CTOT", CTOT), ("BOFF", CTOT - H), ("KS", KS)],
+        grid=(32, D, H),
+        threadgroup=(32, 4, 1),
+        output_shapes=[shp, state.shape, (1, KS - 1, C), shp, shp, shp],
+        output_dtypes=[dt, state.dtype, dt, dt, dt, dt],
+    )
+    return outs
